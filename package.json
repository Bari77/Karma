{
  "name": "karma",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev -w @karma/api",
    "dev:web": "npm run dev -w @karma/web",
    "build": "npm run build --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @karma/api",
    "db:seed": "npm run db:seed -w @karma/api"
  }
}
