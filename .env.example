# Copier sur le serveur : cp .env.example .env puis éditer les secrets.
# Docker Compose charge .env automatiquement (compatible Watchtower).

REGISTRY=registry.bariserv.net
KARMA_TAG=latest

KARMA_WEB_HOST=karma.bariserv.net
KARMA_API_HOST=karma.api.bariserv.net

CORS_ORIGIN=https://karma.bariserv.net
NEXT_PUBLIC_API_URL=https://karma.api.bariserv.net

POSTGRES_USER=karma
POSTGRES_PASSWORD=change-me
POSTGRES_DB=karma
JWT_SECRET=change-me-long-random-string

KARMA_DATA_PATH=/opt/karma
